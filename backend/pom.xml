<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.santhula</groupId>
  <artifactId>rms-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>RMS backend</name>
  <description>Restaurant Management System - Santhula Hotel (modular monolith)</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Contract (ADR-005): bundled from ../docs/api by redocly, then generated. -->
    <redocly.cli.version>2.82.0</redocly.cli.version>
    <openapi.root>${project.basedir}/../docs/api/openapi.yaml</openapi.root>
    <openapi.bundle>${project.build.directory}/openapi.bundled.yaml</openapi.bundle>
    <npx.executable>npx</npx.executable>

    <!-- Pinned versions not managed by Spring Boot -->
    <openapi-generator.version>7.10.0</openapi-generator.version>
    <swagger-annotations.version>2.2.30</swagger-annotations.version>
    <fastexcel.version>0.20.2</fastexcel.version>
    <commons-csv.version>1.14.1</commons-csv.version>
    <archunit.version>1.4.1</archunit.version>
    <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>
    <build-helper-maven-plugin.version>3.6.1</build-helper-maven-plugin.version>
    <maven-wrapper-plugin.version>3.3.4</maven-wrapper-plugin.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Annotations referenced by the generated interfaces / models -->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations-jakarta</artifactId>
      <version>${swagger-annotations.version}</version>
    </dependency>
    <!-- Spreadsheet import (M1.1): CSV and XLSX readers -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-csv</artifactId>
      <version>${commons-csv.version}</version>
    </dependency>
    <dependency>
      <groupId>org.dhatim</groupId>
      <artifactId>fastexcel-reader</artifactId>
      <version>${fastexcel.version}</version>
    </dependency>
    <!-- Excel export (audit log, later reports) -->
    <dependency>
      <groupId>org.dhatim</groupId>
      <artifactId>fastexcel</artifactId>
      <version>${fastexcel.version}</version>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- The bundled contract on the classpath: PermissionInterceptor reads x-permission from it. -->
      <resource>
        <directory>${project.build.directory}</directory>
        <includes>
          <include>openapi.bundled.yaml</include>
        </includes>
        <targetPath>openapi</targetPath>
      </resource>
    </resources>
    <plugins>
      <!-- 1. Bundle the split spec into one file (both generators read the bundle, ADR-005). -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>redocly-bundle</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${npx.executable}</executable>
              <workingDirectory>${project.basedir}/..</workingDirectory>
              <arguments>
                <argument>--yes</argument>
                <argument>@redocly/cli@${redocly.cli.version}</argument>
                <argument>bundle</argument>
                <argument>${openapi.root}</argument>
                <argument>-o</argument>
                <argument>${openapi.bundle}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- 2. Generate Spring interfaces + DTOs from the bundle (never committed). -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator.version}</version>
        <executions>
          <execution>
            <id>generate-api</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>target/openapi.bundled.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <apiPackage>com.santhula.rms.api.generated.api</apiPackage>
              <modelPackage>com.santhula.rms.api.generated.model</modelPackage>
              <generateSupportingFiles>false</generateSupportingFiles>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <schemaMappings>
                <schemaMapping>Money=java.math.BigDecimal</schemaMapping>
                <schemaMapping>Rate=java.math.BigDecimal</schemaMapping>
              </schemaMappings>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <useSpringBoot3>true</useSpringBoot3>
                <useTags>true</useTags>
                <skipDefaultInterface>true</skipDefaultInterface>
                <useBeanValidation>true</useBeanValidation>
                <openApiNullable>false</openApiNullable>
                <!-- Lists start as null, so a missing required array fails @NotNull (422) instead of
                     silently becoming []. -->
                <containerDefaultToNull>true</containerDefaultToNull>
                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                <sourceFolder>src/main/java</sourceFolder>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <profiles>
            <profile>dev</profile>
          </profiles>
        </configuration>
      </plugin>

      <!-- Unit tests (*Test) in `test`, integration tests (*IT, Testcontainers) in `verify`. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/*IT.java</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <systemPropertyVariables>
            <rms.openapi.bundle>${openapi.bundle}</rms.openapi.bundle>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-wrapper-plugin</artifactId>
        <version>${maven-wrapper-plugin.version}</version>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- npx is npx.cmd on Windows -->
    <profile>
      <id>windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <npx.executable>npx.cmd</npx.executable>
      </properties>
    </profile>
    <!-- -Dskip.bundle: reuse an existing target/openapi.bundled.yaml (no Node needed). -->
    <profile>
      <id>skip-bundle</id>
      <activation>
        <property>
          <name>skip.bundle</name>
        </property>
      </activation>
      <properties>
        <exec.skip>true</exec.skip>
      </properties>
    </profile>
  </profiles>
</project>
