{
  "name": "rms-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright E2E, API acceptance and permission-matrix tests for the Santhula Hotel RMS (owner: qa-engineer)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "api:gen": "openapi-typescript ../build/openapi.bundled.yaml -o generated/schema.d.ts",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:e2e": "playwright test --project=chromium-desktop --project=kds-tablet",
    "test:list": "playwright test --list",
    "pretypecheck": "npm run api:gen",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report playwright-report",
    "test:parallel": "playwright test --project=chromium-desktop --project=kds-tablet --no-deps",
    "test:serial": "playwright test --project=serial --no-deps --workers=1",
    "test:all": "playwright test --project=unit --project=chromium-desktop --project=kds-tablet && playwright test --project=serial --no-deps --workers=1",
    "test:smoke": "playwright test --project=smoke --workers=4"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
