# Copy to .env (git-ignored) or export in the shell. Test values only.
RMS_BASE_URL=http://localhost:3000
RMS_API_URL=http://localhost:8080/api/v1
# Defaults to ../build/openapi.bundled.yaml
# RMS_OPENAPI_BUNDLE=
# 1 = seed through the API in global setup
RMS_SEED=0
# Bootstrap owner created by the backend on first start (same values as the backend's test config)
RMS_BOOTSTRAP_OWNER_USERNAME=
RMS_BOOTSTRAP_OWNER_PASSWORD=
RMS_BOOTSTRAP_OWNER_PIN=
# Password the seed sets on all other seeded users (8-72 chars, not equal to the username)
RMS_SEED_PASSWORD="Rms#E2e-2026"
RMS_TEST_RESET=0
# Optional: second backend with RMS_AUDIT_EXPORT_MAX_ROWS=30 (P1-AUD-03-T12)
RMS_API_URL_LOW_EXPORT=
