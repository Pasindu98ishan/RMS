# Copy to .env.local to change defaults.
# true = run against the openapi-msw mocks in the browser (no backend needed).
VITE_USE_MOCKS=false
# API base path (same origin; Vite proxies /api and /ws to http://localhost:8080 in dev).
VITE_API_BASE=/api/v1

# Dev server port (default 3000, fails if taken) and backend proxy target (default http://localhost:8080).
# Handy for running a second stack beside the normal one.
# RMS_FRONTEND_PORT=3000
# RMS_BACKEND_URL=http://localhost:8080
